#include <windows.h>
#include "resource.h"

#pragma code_page(65001)

IDI_APP ICON "app.ico"

IDD_SETTINGS DIALOGEX 0, 0, 460, 400
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_LAYOUTRTL
CAPTION "إعدادات أذكار سطح المكتب v2.0"
FONT 10, "Segoe UI", 400, 0, 0x1
BEGIN
    /* ═══════════ مجموعة الأذكار ═══════════ */
    GROUPBOX        "الأذكار", -1, 6, 4, 448, 140
    LISTBOX         IDC_LIST, 12, 16, 220, 122, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP | WS_BORDER

    LTEXT           "نص الذِكر:", -1, 238, 18, 60, 10
    EDITTEXT        IDC_EDIT_TEXT, 238, 29, 210, 14, ES_AUTOHSCROLL
    LTEXT           "عدد مرات الظهور في اليوم:", -1, 238, 49, 100, 10
    EDITTEXT        IDC_EDIT_COUNT, 396, 47, 48, 14, ES_NUMBER
    AUTOCHECKBOX    "دائماً (بلا حدود)", IDC_CHK_ALWAYS, 238, 65, 100, 12
    PUSHBUTTON      "إضافة", IDC_BTN_ADD, 238, 84, 48, 14
    PUSHBUTTON      "تعديل", IDC_BTN_UPDATE, 289, 84, 48, 14
    PUSHBUTTON      "حذف", IDC_BTN_DELETE, 340, 84, 48, 14
    LTEXT           "العداد يتصفّر تلقائياً كل يوم.", -1, 238, 104, 150, 18

    /* ═══════════ مجموعة التموضع ═══════════ */
    GROUPBOX        "التموضع", -1, 6, 148, 220, 90
    LTEXT           "الموضع:", -1, 12, 163, 40, 10
    COMBOBOX        IDC_CMB_POSITION, 55, 161, 164, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "النزول (Y):", -1, 12, 181, 42, 10
    CONTROL         "", IDC_SLIDER_YOFFSET, "msctls_trackbar32", WS_TABSTOP | TBS_AUTOTICKS, 55, 179, 130, 15
    EDITTEXT        IDC_EDIT_YOFFSET, 188, 179, 30, 14, ES_NUMBER
    LTEXT           "الهامش (X):", -1, 12, 199, 42, 10
    CONTROL         "", IDC_SLIDER_XMARGIN, "msctls_trackbar32", WS_TABSTOP | TBS_AUTOTICKS, 55, 197, 130, 15
    EDITTEXT        IDC_EDIT_XMARGIN, 188, 197, 30, 14, ES_NUMBER
    AUTOCHECKBOX    "تناسق تلقائي مع حجم الذكر", IDC_CHK_AUTOFIT, 12, 218, 200, 12

    /* ═══════════ مجموعة الخط ═══════════ */
    GROUPBOX        "الخط", -1, 232, 148, 222, 90
    LTEXT           "نوع الخط:", -1, 238, 163, 45, 10
    COMBOBOX        IDC_CMB_FONT, 285, 161, 162, 100, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "حجم الخط:", -1, 238, 183, 45, 10
    CONTROL         "", IDC_SLIDER_FONTSIZE, "msctls_trackbar32", WS_TABSTOP | TBS_AUTOTICKS, 285, 181, 130, 15
    EDITTEXT        IDC_EDIT_FONTSIZE, 418, 181, 30, 14, ES_NUMBER

    /* ═══════════ مجموعة المظهر والتوقيت ═══════════ */
    GROUPBOX        "المظهر والتوقيت", -1, 6, 242, 448, 110
    LTEXT           "التصميم:", -1, 12, 258, 50, 10
    COMBOBOX        IDC_CMB_STYLE, 64, 256, 190, 120, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "الأنيميشن:", -1, 12, 278, 50, 10
    COMBOBOX        IDC_CMB_ANIM, 64, 276, 190, 100, CBS_DROPDOWNLIST | WS_TABSTOP
    PUSHBUTTON      "معاينة ▶", IDC_BTN_PREVIEW, 12, 298, 70, 16

    LTEXT           "الفاصل بين الإشعارات (ثانية):", -1, 270, 258, 120, 10
    EDITTEXT        IDC_EDIT_INTERVAL, 396, 256, 48, 14, ES_NUMBER
    LTEXT           "مدة ظهور الإشعار (ثانية):", -1, 270, 278, 120, 10
    EDITTEXT        IDC_EDIT_DURATION, 396, 276, 48, 14, ES_NUMBER
    AUTOCHECKBOX    "تشغيل مع بدء الويندوز", IDC_CHK_STARTUP, 270, 298, 140, 12

    /* ═══════════ الشريط السفلي ═══════════ */
    LTEXT           "", IDC_STATIC_INFO, 6, 360, 350, 10
    DEFPUSHBUTTON   "حفظ وإغلاق", IDOK, 380, 358, 70, 18
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Azkar Desktop Notifier v2.0"
            VALUE "FileVersion", "2.0.0.0"
            VALUE "ProductName", "Azkar Desktop Notifier"
            VALUE "ProductVersion", "2.0.0.0"
            VALUE "OriginalFilename", "AzkarNotifier.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
